# Default deny: only maintained code, documentation and authored fixtures enter Git.
*
!*/
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/LICENSE
!/NOTICE
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/.github/workflows/*.yml
!/crates/*/Cargo.toml
!/crates/*/src/**/*.rs
!/crates/*/examples/*.rs
!/crates/windows_shell/assets/development-checker.bmp
!/docs/**/*.md
!/docs/*.csv
!/docs/release/dependency-inventory.csv
!/docs/release/*-LICENSE.txt
!/docs/release/*-MIT.txt
!/docs/release/*-Zlib.txt
!/tools/*.ps1
!/tools/*.cs
!/tools/*.cpp
!/tools/*.java
!/tools/fixtures/*.cs
!/tools/fixtures/*.c
/target/
/.local/
/private/
/research/
/captures/
/cache/
/saves/
/dist/
