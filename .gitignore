# Default deny: only maintained code, documentation and authored fixtures enter Git.
*
!*/
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/ARCHITECTURE.md
!/CONTRIBUTING.md
!/LICENSE
!/NOTICE
!/CREDITS.md
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/.cargo/config.toml
!/build.bat
!/.github/workflows/*.yml
!/.github/pull_request_template.md
!/source/main/Cargo.toml
!/source/main/src/**/*.rs
!/source/visual/Cargo.toml
!/source/visual/src/**/*.rs
!/validation/Cargo.toml
!/validation/src/**/*.rs
!/data/Cargo.toml
!/data/src/**/*.rs
!/audio/Cargo.toml
!/audio/src/**/*.rs
!/effect/Cargo.toml
!/effect/src/**/*.rs
!/source/game/*/Cargo.toml
!/source/game/*/src/**/*.rs
!/extras/skateboard/source/Cargo.toml
!/extras/skateboard/source/src/**/*.rs
!/extras/skateboard/engine/*/Cargo.toml
!/extras/skateboard/engine/*/src/**/*.rs
!/source/main/examples/*.rs
!/source/main/src/**/*.wgsl
!/data/examples/*.rs
!/extras/skateboard/source/examples/*.rs
!/source/visual/src/**/*.wgsl
!/source/game/README.md
!/source/main/README.md
!/source/visual/README.md
!/validation/README.md
!/data/README.md
!/audio/README.md
!/effect/README.md
!/extras/README.md
# Preserve the optional extension's source attribution, license and name dictionary.
!/extras/skateboard/engine/README.md
!/extras/skateboard/engine/LICENSE
!/extras/skateboard/engine/skate-disc/src/names.txt
# Authored development image, title banner and project logo only.
!/source/main/assets/development-checker.bmp
!/source/visual/assets/final-rewrite-text.png
!/source/visual/assets/kingdom-hearts-final-rewrite-logo.png
!/docs/**/*.md
!/docs/research/*.csv
!/docs/release/dependency-inventory.csv
!/docs/release/*-LICENSE.txt
!/docs/release/*-MIT.txt
!/docs/release/*-Zlib.txt
!/tools/*.ps1
!/tools/*.md
!/tools/*.cs
!/tools/*.cpp
!/tools/*.java
!/tools/fixtures/*.cs
!/tools/fixtures/*.c
# Authored progress tooling and public aggregate evidence only.
!/tools/progress.py
!/tools/test_progress.py
!/docs/progress/coverage.json
!/docs/progress/summary.json
/target/
/.local/
/private/
/research/
/captures/
/cache/
/saves/
/dist/
