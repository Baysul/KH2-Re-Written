# Default deny: only maintained code, documentation and authored fixtures enter Git.
*
!*/
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/ARCHITECTURE.md
!/CONTRIBUTING.md
!/LICENSE
!/NOTICE
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/.github/workflows/*.yml
!/.github/pull_request_template.md
!/crates/*/Cargo.toml
!/crates/*/src/**/*.rs
!/crates/*/src/**/*.wgsl
!/crates/*/examples/*.rs
!/crates/windows_shell/assets/development-checker.bmp
# The project owner's own studio splash art (not game data).
!/crates/windows_shell/assets/glurbus-splash.png
# Banner text drawn by tools/Make-BannerText.ps1 from a system font (no game data).
!/crates/windows_shell/assets/final-rewrite-text.png
!/docs/**/*.md
!/docs/*.csv
!/docs/release/dependency-inventory.csv
!/docs/release/*-LICENSE.txt
!/docs/release/*-MIT.txt
!/docs/release/*-Zlib.txt
!/tools/*.ps1
!/tools/*.md
!/tools/*.cs
!/tools/*.cpp
!/tools/*.java
!/tools/fixtures/*.cs
!/tools/fixtures/*.c
/target/
/.local/
/private/
/research/
/captures/
/cache/
/saves/
/dist/
